{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sam.example/schemas/offer.schema.json",
  "title": "SAM Offer",
  "type": "object",
  "required": ["schema_version", "offer_id", "name", "type", "description", "audience_ids", "benefits", "features", "pricing", "availability", "destination", "claims", "required_disclosures"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "offer_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "audience_ids": {"type": "array", "items": {"type": "string"}},
    "problems": {"type": "array", "items": {"type": "string"}},
    "benefits": {
      "type": "object",
      "required": ["confirmed", "requires_evidence"],
      "properties": {
        "confirmed": {"type": "array", "items": {"type": "string"}},
        "requires_evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "features": {"type": "array", "items": {"type": "string"}},
    "proof": {"type": "object"},
    "pricing": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["confirmed", "not-provided", "requires-confirmation"]},
        "amount": {"type": ["number", "string", "null"]},
        "currency": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["confirmed", "not-provided", "requires-confirmation"]},
        "details": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": ["url"],
      "properties": {"url": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "required": ["approved", "prohibited"],
      "properties": {
        "approved": {"type": "array", "items": {"type": "string"}},
        "prohibited": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "required_disclosures": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
